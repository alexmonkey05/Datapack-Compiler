# 버전 제한: 이 파일을 26.2로 컴파일하면 새 compute 함수에서 VersionError가 나야 한다.

def test_compute_conversions(){
    print("=== int / float casts: truncate toward zero, preserve int boundaries ===")
    print("[V01] int(2.9) | expected=2 | actual=", int(2.9))
    print("[V02] int(-2.9) | expected=-2 | actual=", int(-2.9))
    print("[V03] int(-0.9) | expected=0 | actual=", int(-0.9))
    print("[V04] float(7) | expected=7.0f | actual=", float(7))
    print("[V05] float(-7) | expected=-7.0f | actual=", float(-7))
    print("[V06] float(2.5) | expected=2.5f | actual=", float(2.5))
    print("[V07] int(INT_MAX) | expected=2147483647 | actual=", int(2147483647))
    print("[V08] int(INT_MIN) | expected=-2147483648 | actual=", int(-2147483648))
    var cast_integer = 2147483647
    var cast_fraction = -2.9
    print("[V09] int(variable INT_MAX) | expected=2147483647 | actual=", int(cast_integer))
    print("[V10] int(variable -2.9) | expected=-2 | actual=", int(cast_fraction))
    print("[V11] float(variable -2.9) | expected=approx -2.9f | actual=", float(cast_fraction))
    print("[V12] float(int(avg(1,2))) | expected=1.0f | actual=", float(int(avg(1, 2))))
    print("[V13] int numeric string | expected=-2 | actual=", int("-2.9"))
    print("[V14] float numeric string | expected=2.5f | actual=", float("2.5"))
    print("[V15] float(16777217) | expected=16777216f (float precision) | actual=", float(16777217))
    var cast_small_integer = 7
    print("[V16] float(variable 7) | expected=7.0f | actual=", float(cast_small_integer))
}

def run_compute_tests(){
    test_compute_arithmetic()
    test_compute_comparisons()
    test_compute_aggregates()
    test_compute_numeric_pairs()
    test_compute_rounding()
    test_compute_trigonometry()
    test_compute_random()
    test_compute_nested()
    test_compute_conversions()
    print("=== compute edge cases finished: compare expected / actual above ===")
}

run_compute_tests()
